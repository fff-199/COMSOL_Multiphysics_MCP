{
 "essential_difference": {
  "Parametric": "IN-PROCESS solver loop (solver feature 'Parametric'; no batchfile props)",
  "BatchSweep": "N independent comsolbatch.exe processes; per-parameter-case .mph written; client reconnects via -host/-port; solutions synthesized back (synchsolutions/accumulated probe table)",
  "ClusterSweep": "BatchSweep + comsolclusterbatch.exe + scheduler (clustertype/hostfile; whpc2008=Windows HPC)"
 },
 "batch_command": "comsolbatch.exe -job <tag> [-host h -port p] -inputfile <case.mph> -outputfile <out.mph> -batchlog <case.log> -recover   (cluster: comsolclusterbatch.exe)",
 "job_management": {
  "maxrestart": "cluster.settings.maxrestart pref; default set 1",
  "maxalive": "alive-process cap",
  "recovery": "-recover flag; per-case logs"
 },
